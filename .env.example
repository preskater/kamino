# Copy to .env and adjust. Both services read this file from the working directory.
RUST_LOG=info,kamino=debug,tower_http=debug

# Comma separated list of allowed CORS origins, or "*" for any.
CORS_ALLOWED_ORIGINS=*

# Used by tests (#[sqlx::test] creates throwaway databases on this server).
DATABASE_URL=postgres://kamino:kamino@localhost:5432/postgres

# --- agents service -------------------------------------------------------
AGENTS_BIND_ADDR=0.0.0.0:8081
AGENTS_DATABASE_URL=postgres://kamino:kamino@localhost:5432/kamino_agents
AGENTS_DB_MAX_CONNECTIONS=10

# --- projects service -----------------------------------------------------
PROJECTS_BIND_ADDR=0.0.0.0:8082
PROJECTS_DATABASE_URL=postgres://kamino:kamino@localhost:5432/kamino_projects
PROJECTS_DB_MAX_CONNECTIONS=10
